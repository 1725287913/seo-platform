# ============================================================
#  .env 配置模板
#
#  用法：把本文件复制一份、改名为 .env，然后填入你自己的密钥。
#    Windows:  copy .env.example .env
#    Mac/Linux: cp .env.example .env
#
#  为什么要有「模板」和「真实文件」两份？
#    .env.example（本文件）会进 Git —— 它只有变量名，没有值；
#    .env（你自己填的那份）不会进 Git —— 它才是真正藏着密钥的文件。
#  这样别人下载项目后拿到的是模板，永远看不到你的密钥。
# ============================================================

# ---------- ① 模型密钥（至少配一家，否则无法生成文章）----------
# 推荐 DeepSeek：中文写作好、价格低，注册即送额度
# 申请地址 https://platform.deepseek.com  →  API Keys  →  创建
# 提示：界面上「API 密钥」页可以点选服务商一键写入，不用手动改本文件
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# ---------- ② 其他可选 AI 服务商 ----------
# 用到哪家，就把对应那行前面的 # 去掉并填上密钥；
# 没用到就保持注释状态（别留空值，空值会把默认配置覆盖掉）。
# SILICONFLOW_API_KEY=      # 硅基流动 https://siliconflow.cn
# MOONSHOT_API_KEY=         # Kimi 月之暗面 https://platform.moonshot.cn
# ZHIPU_API_KEY=            # 智谱 GLM https://bigmodel.cn
# DASHSCOPE_API_KEY=        # 通义千问 https://dashscope.aliyun.com
# QIANFAN_API_KEY=          # 百度千帆 https://qianfan.cloud.baidu.com
# VOLC_API_KEY=             # 火山方舟（豆包）https://volcengine.com
# MINIMAX_API_KEY=          # MiniMax https://platform.minimaxi.com
# OPENAI_API_KEY=           # OpenAI https://platform.openai.com
# GEMINI_API_KEY=           # Google Gemini https://aistudio.google.com
# GROQ_API_KEY=             # Groq（有免费额度）https://console.groq.com
# OPENROUTER_API_KEY=       # OpenRouter https://openrouter.ai
# OLLAMA_API_KEY=           # 本地 Ollama（本地跑模型，无需真的密钥）
# LMSTUDIO_API_KEY=         # 本地 LM Studio
# CUSTOM_API_KEY=           # 其他任意 OpenAI 兼容接口

# ---------- ③ 百度主动推送（想跑通百度收录才需要）----------
# BAIDU_SITE：你的站点域名（不带 http://），例如 www.mysite.com
# BAIDU_TOKEN：登录 https://ziyuan.baidu.com → 添加站点并验证归属
#              → 普通收录 → 主动推送 → 复制那串 token
BAIDU_SITE=
BAIDU_TOKEN=

# ---------- ④ 配图（可选）----------
# 留空则只生成「配图提示词」，不自动出图（可复制到任意绘图工具使用）
# 填了则自动调用 ImageGen 出封面图，接口需为 OpenAI 兼容格式
IMAGE_API_BASE=
IMAGE_API_KEY=
IMAGE_MODEL=default
